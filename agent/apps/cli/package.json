{
  "name": "@tut/cli",
  "version": "0.0.65",
  "type": "module",
  "bin": {
    "lh": "dist/index.js",
    "tut": "dist/index.js",
    "mcit": "dist/index.js"
  },
  "man": [
    "./man/man1/lh.1",
    "./man/man1/tut.1",
    "./man/man1/mcit.1"
  ],
  "files": [
    "dist",
    "man"
  ],
  "scripts": {
    "build": "bun scripts/ensureWorkspaceLinks.ts && tsdown && tsdown src/daemon/maintenanceWorker.ts --no-config --no-clean --format esm --target node22",
    "cli:link": "bun link",
    "cli:unlink": "bun unlink",
    "dev": "MCIT_CLI_HOME=.mcit-dev bun src/index.ts",
    "man:generate": "bun src/man/generate.ts",
    "prepublishOnly": "npm run build && npm run man:generate",
    "test": "bunx vitest run --config vitest.config.mts --silent='passed-only'",
    "test:coverage": "bunx vitest run --config vitest.config.mts --coverage",
    "test:e2e": "bunx vitest run --config vitest.e2e.config.mts --silent='passed-only'",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@trpc/client": "^11.18.0",
    "@tut/agent-gateway-client": "workspace:*",
    "@tut/agent-tracing": "workspace:*",
    "@tut/const": "workspace:*",
    "@tut/device-control": "workspace:*",
    "@tut/device-gateway-client": "workspace:*",
    "@tut/device-identity": "workspace:*",
    "@tut/eval-rubric": "workspace:*",
    "@tut/heterogeneous-agents": "workspace:*",
    "@tut/html-artifact": "workspace:*",
    "@tut/local-file-shell": "workspace:*",
    "@tut/tool-runtime": "workspace:*",
    "@tut/types": "workspace:*",
    "@tut/utils": "workspace:*",
    "@types/node": "^24.13.2",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "commander": "^13.1.0",
    "dayjs": "^1.11.21",
    "debug": "^4.4.3",
    "diff": "^8.0.4",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "superjson": "^2.2.6",
    "tinyexec": "^1.3.0",
    "tree-kill": "^1.2.2",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "url-join": "^5.0.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
