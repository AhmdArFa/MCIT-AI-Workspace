# MCIT AI — private self-host env (based on Mcit deploy)
# Copy to .env and fill secrets before `docker compose up`.
# Goal: keep data on-prem. Do not set PostHog, Sentry, Langfuse, or cloud keys
# unless an approved egress path exists.

TUT_PORT=3210
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
APP_URL=http://localhost:3210
INTERNAL_APP_URL=http://localhost:3210

# Generate with: openssl rand -base64 32
KEY_VAULTS_SECRET=CHANGE_ME_KEY_VAULTS_SECRET
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
GATEWAY_SERVICE_TOKEN=CHANGE_ME_GATEWAY_TOKEN
# JWKS_KEY / JWKS_PUBLIC_KEY: run docker-compose/setup.sh once, or generate RS256 JWKS

TUT_DB_NAME=mcit_ai
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

S3_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=CHANGE_ME_RUSTFS_PASSWORD
RUSTFS_TUT_BUCKET=mcit

AGENT_GATEWAY_PORT=8787
DEVICE_GATEWAY_PORT=8788
AGENT_GATEWAY_URL=http://localhost:8787
DEVICE_GATEWAY_URL=http://gateway:8788

# --- Privacy / analytics (keep disabled for official data) ---
TELEMETRY_DISABLED=1
# Do NOT set: POSTHOG_KEY, NEXT_PUBLIC_SENTRY_DSN, LANGFUSE_SECRET_KEY, LANGFUSE_PUBLIC_KEY

# --- Local models (Ollama on host; host.docker.internal or host network) ---
ENABLED_OLLAMA=1
OLLAMA_PROXY_URL=http://host.docker.internal:11434
# OLLAMA_MODEL_LIST=qwen2.5:7b

# Optional: allow private LAN targets only when you control the network
# SSRF_ALLOW_PRIVATE_IP_ADDRESS=1

# --- MCIT auth / admin ---
# Browser origins allowed for cookies (comma-separated)
AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3210,http://127.0.0.1:3210
# One-time admin bootstrap (openssl rand -hex 32). Remove after first admin.
# MCIT_ADMIN_BOOTSTRAP_TOKEN=
# Studio local model
MCIT_STUDIO_MODEL=qwen2.5:7b
OLLAMA_PROXY_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
FEATURE_FLAGS=-auth_captcha,-market,-cloud_promotion,-welcome_suggest
